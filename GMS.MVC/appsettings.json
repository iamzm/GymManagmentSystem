{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnections": "server=localhost,1433;Database=GymManagmentSystem;User Id=sa;Password=sa;TrustServerCertificate=True;"
  },
  "Gym": {
    // Change These Two To Serve A Different Market; No View Hard-Codes A Currency.
    "Currency": {
      "Code": "PKR",
      "Format": "N0",
      "CodeBeforeAmount": false
    }
  },
  "Seed": {
    "AdminEmail": "admin@powerfitness.com",
    "AdminFullName": "Gym Administrator",
    // NOTE: A Real Password Is Sitting In Source Control Here. Prefer Supplying It Per
    // Environment — User Secrets Locally, Or The Seed__AdminPassword Environment Variable On The
    // Server — And Leaving This Blank, So Rotating It Does Not Mean A Commit.
    "AdminPassword": "P@ssw0rd32!",

    // Recovery Hatch. Set To true With AdminPassword Filled In To Reset The Existing
    // Administrator's Password And Clear Any Lockout On The Next Start, Then Set It Back To false.
    // Needed Because The Seeder Only Ever *Creates* The Admin — Changing AdminPassword After The
    // Account Exists Does Nothing On Its Own.
    "ResetAdminPassword": false,

    "SeedDemoData": true,

    // DESTRUCTIVE, AND IT RUNS ON EVERY START WHILE IT IS true. Set It Back To false Once The
    // Sample Data Has Been Reloaded, Or Each Restart Wipes The People, Sessions, Memberships,
    // Bookings And Plans And Lays The Samples Down Again.
    "ResetDemoData": true
  }
}
