@model IEnumerable<TrainerDTO>
@{
    ViewData["Title"] = "Trainers";
    ViewData["Crumb"] = "The coaching team";
    var search = ViewBag.Search as string;
    var specialty = ViewBag.Specialty as int?;
    var trainers = Model?.ToList() ?? [];
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">People</div>
        <h1 class="page-head__title">Trainers</h1>
        <p class="page-head__sub">@trainers.Count trainer@(trainers.Count == 1 ? "" : "s") shown · @trainers.Sum(T => T.UpcomingSessionCount) upcoming classes between them</p>
    </div>
    @if (isAdmin) {
        <div class="page-head__actions">
            <a class="btn-app btn-app--primary" asp-action="Create">
                <i class="bi bi-person-plus"></i> Add Trainer
            </a>
        </div>
    }
</div>

<form class="toolbar" method="get" asp-action="Index" data-search-form>
    <div class="search-field">
        <i class="bi bi-search"></i>
        <input type="search" name="search" value="@search" placeholder="Search by name, email or specialty…" aria-label="Search trainers" />
    </div>

    <select name="specialty" class="input-app" style="max-width:280px" onchange="this.form.submit()" aria-label="Filter by specialty">
        <option value="">All specialties</option>
        @foreach (var item in Html.GetEnumSelectList<Specialties>()) {
            <option value="@item.Value" selected="@(specialty?.ToString() == item.Value)">@item.Text</option>
        }
    </select>

    @if (!string.IsNullOrWhiteSpace(search) || specialty is > 0) {
        <a class="btn-app btn-app--ghost btn-app--sm ms-auto" asp-action="Index">
            <i class="bi bi-x-lg"></i> Clear
        </a>
    }
</form>

@if (trainers.Count > 0) {
    <div class="row g-4">
        @foreach (var trainer in trainers) {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card-app card-app--hover h-100">
                    <div class="card-app__body">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <partial name="_Avatar" model="@(new AvatarModel { Name = trainer.Name, Photo = trainer.Photo, Folder = "trainers", Size = "lg" })" />
                            <div class="min-width-0 flex-grow-1">
                                <h2 class="h5 mb-1 text-truncate">@trainer.Name</h2>
                                <span class="pill pill--brand"><i class="bi bi-award"></i>@trainer.Specialties</span>
                            </div>

                            <div class="dropdown">
                                <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @trainer.Name">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-action="TrainerDetails" asp-route-id="@trainer.Id">
                                            <i class="bi bi-person-lines-fill"></i> View profile
                                        </a>
                                    </li>
                                    @if (isAdmin) {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item" asp-action="EditTrainer" asp-route-id="@trainer.Id">
                                                <i class="bi bi-pencil"></i> Edit details
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@trainer.Id">
                                                <i class="bi bi-trash"></i> Delete trainer
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <div class="d-grid gap-2 fs-14 text-muted-2">
                            <span class="text-truncate"><i class="bi bi-envelope me-2 text-brand"></i>@trainer.Email</span>
                            <span class="mono-num"><i class="bi bi-telephone me-2 text-brand"></i>@trainer.Phone</span>
                            <span class="text-truncate"><i class="bi bi-geo-alt me-2 text-brand"></i>@trainer.Address</span>
                        </div>
                    </div>

                    <div class="card-app__foot d-flex align-items-center justify-content-between">
                        <div class="fs-14 text-muted-2">
                            <span class="mono-num fw-600">@trainer.SessionCount</span> classes ·
                            <span class="mono-num fw-600">@trainer.UpcomingSessionCount</span> upcoming
                        </div>
                        <a class="btn-app btn-app--ghost btn-app--sm" asp-action="TrainerDetails" asp-route-id="@trainer.Id">
                            <i class="bi bi-eye"></i> View
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else {
    <div class="card-app">
        <div class="empty-state">
            <div class="empty-state__icon"><i class="bi bi-person-badge"></i></div>
            @if (!string.IsNullOrWhiteSpace(search) || specialty is > 0) {
                <h2 class="empty-state__title">No trainers match that</h2>
                <p class="empty-state__text">Try a different search term or specialty.</p>
                <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-x-lg"></i> Clear filters</a>
            }
            else {
                <h2 class="empty-state__title">No trainers yet</h2>
                <p class="empty-state__text">Add your first trainer so you can start scheduling classes.</p>
                @if (isAdmin) {
                    <a class="btn-app btn-app--primary" asp-action="Create"><i class="bi bi-person-plus"></i> Add Trainer</a>
                }
            }
        </div>
    </div>
}
