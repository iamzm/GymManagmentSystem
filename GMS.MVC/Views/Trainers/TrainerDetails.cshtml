@model TrainerDTO
@{
    ViewData["Title"] = Model.Name;
    ViewData["Crumb"] = "Trainer profile";
    var sessions = (ViewBag.Sessions as IEnumerable<SessionDTO> ?? []).ToList();
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">People · Trainers</div>
        <h1 class="page-head__title">@Model.Name</h1>
        <p class="page-head__sub">Trainer #@Model.Id · hired @Model.HiredOn.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="page-head__actions">
        <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to list</a>
        @if (isAdmin) {
            <a class="btn-app btn-app--primary" asp-action="EditTrainer" asp-route-id="@Model.Id">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="card-app">
            <div class="card-app__body text-center">
                <partial name="_Avatar" model="@(new AvatarModel { Name = Model.Name, Photo = Model.Photo, Folder = "trainers", Size = "xl" })" />
                <h2 class="h4 mt-3 mb-1">@Model.Name</h2>
                <p class="text-muted-2 mb-3">@Model.Email</p>
                <span class="pill pill--brand"><i class="bi bi-award"></i>@Model.Specialties</span>
            </div>
            <div class="card-app__foot">
                <div class="row text-center g-0">
                    <div class="col-6 border-end" style="border-color:var(--border) !important">
                        <div class="h5 mb-0 mono-num">@Model.SessionCount</div>
                        <div class="fs-13 text-muted-2">Total classes</div>
                    </div>
                    <div class="col-6">
                        <div class="h5 mb-0 mono-num">@Model.UpcomingSessionCount</div>
                        <div class="fs-13 text-muted-2">Upcoming</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card-app mb-4">
            <div class="card-app__head">
                <span class="icon-chip"><i class="bi bi-person-vcard"></i></span>
                <div><h2 class="card-app__title">Contact details</h2></div>
            </div>
            <div class="card-app__body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-item__label">Email</div>
                        <div class="detail-item__value">@Model.Email</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Phone</div>
                        <div class="detail-item__value mono-num">@Model.Phone</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Gender</div>
                        <div class="detail-item__value">@Model.Gender</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Date of Birth</div>
                        <div class="detail-item__value">@Model.DateOfBirth</div>
                    </div>
                    <div class="detail-item" style="grid-column:1/-1">
                        <div class="detail-item__label">Address</div>
                        <div class="detail-item__value">@Model.Address</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-app">
            <div class="card-app__head">
                <span class="icon-chip"><i class="bi bi-activity"></i></span>
                <div>
                    <h2 class="card-app__title">Classes led</h2>
                    <p class="card-app__sub">Newest first</p>
                </div>
            </div>
            <div class="card-app__body p-0">
                @if (sessions.Count > 0) {
                    <div class="table-app-scroll">
                        <table class="table-app">
                            <thead>
                                <tr>
                                    <th>Class</th>
                                    <th>When</th>
                                    <th>Seats</th>
                                    <th>Status</th>
                                    <th class="col-actions">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in sessions) {
                                    <tr>
                                        <td class="fw-600">@session.CategoryName</td>
                                        <td class="text-muted-2 fs-14 mono-num">
                                            @session.DateDisplay<br />
                                            <span class="text-subtle">@session.TimeRangeDisplay</span>
                                        </td>
                                        <td class="mono-num">@session.BookedSlots / @session.Capacity</td>
                                        <td><partial name="_StatusPill" model="@session.Status" /></td>
                                        <td class="col-actions">
                                            <a class="btn-app btn-app--ghost btn-app--sm" asp-controller="Session" asp-action="Details" asp-route-id="@session.Id">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else {
                    <div class="empty-state py-4">
                        <div class="empty-state__icon"><i class="bi bi-calendar-x"></i></div>
                        <h3 class="empty-state__title">No classes assigned</h3>
                        <p class="empty-state__text">This trainer hasn't been scheduled to lead a session yet.</p>
                        @if (isAdmin) {
                            <a class="btn-app btn-app--primary" asp-controller="Session" asp-action="Create">
                                <i class="bi bi-calendar-plus"></i> Schedule a session
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
