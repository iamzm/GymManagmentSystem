@model PlanDTO
@{
    ViewData["Title"] = Model.Name;
    ViewData["Crumb"] = "Plan details";
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var perDay = Model.DurationDays > 0 ? Model.Price / Model.DurationDays : 0;
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">Catalogue · Plans</div>
        <h1 class="page-head__title">@Model.Name</h1>
        <p class="page-head__sub">@Model.DurationDays days · @Money.Format(Model.Price)</p>
    </div>
    <div class="page-head__actions">
        <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to plans</a>
        @if (isAdmin) {
            <a class="btn-app btn-app--ghost" asp-controller="Memberships" asp-action="Create">
                <i class="bi bi-card-checklist"></i> Sell this plan
            </a>
            <a class="btn-app btn-app--primary" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="card-app">
            <div class="card-app__head">
                <span class="icon-chip"><i class="bi bi-tag"></i></span>
                <div>
                    <h2 class="card-app__title">@Model.Name</h2>
                    <p class="card-app__sub">Plan #@Model.Id</p>
                </div>
                <span class="ms-auto"><partial name="_StatusPill" model="@(Model.IsActive ? "Active" : "Inactive")" /></span>
            </div>
            <div class="card-app__body">
                <p class="mb-4">@Model.Dsescription</p>

                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-item__label">Price</div>
                        <div class="detail-item__value mono-num">@Money.Format(Model.Price)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Duration</div>
                        <div class="detail-item__value mono-num">@Model.DurationDays days</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Cost Per Day</div>
                        <div class="detail-item__value mono-num">@Money.Format(perDay)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">On Sale</div>
                        <div class="detail-item__value">@(Model.IsActive ? "Yes" : "No")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card-app h-100">
            <div class="card-app__head">
                <span class="icon-chip"><i class="bi bi-info-circle"></i></span>
                <div><h2 class="card-app__title">How plans behave</h2></div>
            </div>
            <div class="card-app__body">
                <ul class="list-unstyled d-grid gap-3 mb-0 fs-14">
                    <li class="d-flex gap-3">
                        <i class="bi bi-lock" style="color:var(--warn-600)"></i>
                        <span>A plan can't be edited or deactivated while members hold live contracts on it — those contracts were already paid for.</span>
                    </li>
                    <li class="d-flex gap-3">
                        <i class="bi bi-calendar-check" style="color:var(--brand-600)"></i>
                        <span>Selling this plan creates a membership that runs for @Model.DurationDays days from its start date.</span>
                    </li>
                    <li class="d-flex gap-3">
                        <i class="bi bi-receipt" style="color:var(--ok-600)"></i>
                        <span>The price is copied onto the contract at sale time, so later price changes never rewrite history.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
