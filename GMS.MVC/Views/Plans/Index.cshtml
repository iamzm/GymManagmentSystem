@model IEnumerable<PlanDTO>
@{
    ViewData["Title"] = "Plans";
    ViewData["Crumb"] = "Membership packages on offer";
    var plans = Model?.ToList() ?? [];
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">Catalogue</div>
        <h1 class="page-head__title">Membership Plans</h1>
        <p class="page-head__sub">@plans.Count(P => P.IsActive) of @plans.Count plan@(plans.Count == 1 ? "" : "s") currently on sale</p>
    </div>
</div>

@if (plans.Count > 0) {
    <div class="row g-4">
        @foreach (var plan in plans) {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card-app card-app--hover h-100 d-flex flex-column">
                    <div class="card-app__body flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="icon-chip"><i class="bi bi-tag"></i></span>
                            <partial name="_StatusPill" model="@(plan.IsActive ? "Active" : "Inactive")" />
                        </div>

                        <h2 class="h5 mb-2">@plan.Name</h2>

                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <span class="stat-tile__value" style="color:var(--brand-on-soft)">@plan.Price.ToString("N0")</span>
                            <span class="text-muted-2">EGP</span>
                        </div>

                        <p class="text-muted-2 fs-14">@plan.Dsescription</p>

                        <div class="fs-14 text-muted-2">
                            <i class="bi bi-calendar-check me-2 text-brand"></i>
                            <span class="mono-num fw-600">@plan.DurationDays</span> days of access
                        </div>
                    </div>

                    <div class="card-app__foot d-flex gap-2">
                        <a class="btn-app btn-app--ghost btn-app--sm flex-fill" asp-action="Details" asp-route-id="@plan.Id">
                            <i class="bi bi-eye"></i> Details
                        </a>

                        @if (isAdmin) {
                            <a class="btn-app btn-app--ghost btn-app--sm btn-icon-only" asp-action="Edit" asp-route-id="@plan.Id" title="Edit plan">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="Activate" asp-route-id="@plan.Id" method="post" class="m-0"
                                  data-confirm="@(plan.IsActive ? $"Deactivate '{plan.Name}'? It will stop being offered to new members." : $"Reactivate '{plan.Name}' and put it back on sale?")">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-app btn-app--sm btn-icon-only @(plan.IsActive ? "btn-app--danger" : "btn-app--soft")"
                                        title="@(plan.IsActive ? "Deactivate plan" : "Activate plan")">
                                    <i class="bi @(plan.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else {
    <div class="card-app">
        <div class="empty-state">
            <div class="empty-state__icon"><i class="bi bi-tags"></i></div>
            <h2 class="empty-state__title">No plans available</h2>
            <p class="empty-state__text">Plans are seeded on first run from <code>wwwroot/Data/plans.json</code>.</p>
        </div>
    </div>
}
