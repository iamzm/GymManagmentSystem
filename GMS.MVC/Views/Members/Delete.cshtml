@model MemberDetailsDTO
@{
    ViewData["Title"] = "Delete Member";
    ViewData["Crumb"] = "This cannot be undone";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card-app">
            <div class="card-app__body text-center">
                <div class="empty-state__icon" style="background:var(--danger-100);color:var(--danger-600)">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h1 class="h4 mb-2">Delete @Model.Name?</h1>
                <p class="text-muted-2">
                    Their profile, health record, subscription history and past bookings will be
                    permanently removed. This cannot be undone.
                </p>

                <div class="d-flex align-items-center gap-3 justify-content-center my-4 p-3 rounded-3" style="background:var(--surface-sunken)">
                    <partial name="_Avatar" model="@(new AvatarModel { Name = Model.Name, Photo = Model.Photo, Folder = "members", Size = "lg" })" />
                    <div class="text-start">
                        <div class="fw-600">@Model.Name</div>
                        <div class="identity__meta">@Model.Email</div>
                        <div class="identity__meta">@Model.TotalMemberships membership@(Model.TotalMemberships == 1 ? "" : "s") · @Model.TotalBookings booking@(Model.TotalBookings == 1 ? "" : "s")</div>
                    </div>
                </div>

                <div class="alert-app alert-app--warn text-start">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>A member booked into a class that hasn't run yet cannot be deleted. Cancel those bookings first.</div>
                </div>

                <form asp-action="DeleteMember" method="post" class="d-flex gap-2 mt-4">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <a class="btn-app btn-app--ghost flex-fill" asp-action="Index">Keep member</a>
                    <button type="submit" class="btn-app btn-app--danger-solid flex-fill">
                        <i class="bi bi-trash"></i> Delete permanently
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
