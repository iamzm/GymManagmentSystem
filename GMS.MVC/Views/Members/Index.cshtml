@model IEnumerable<MemberDTO>
@{
    ViewData["Title"] = "Members";
    ViewData["Crumb"] = "Everyone training at Power Fitness";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var members = Model?.ToList() ?? [];
    var isAdmin = User.IsInRole(AppRoles.Admin);

    string ChipClass(string? value) => status == value || (string.IsNullOrEmpty(status) && value is null)
        ? "chip is-active" : "chip";
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">People</div>
        <h1 class="page-head__title">Members</h1>
        <p class="page-head__sub">@members.Count member@(members.Count == 1 ? "" : "s") shown · @members.Count(M => M.IsActive) with an active plan</p>
    </div>
    @if (isAdmin) {
        <div class="page-head__actions">
            <a class="btn-app btn-app--primary" asp-action="Create">
                <i class="bi bi-person-plus"></i> Add Member
            </a>
        </div>
    }
</div>

<form class="toolbar" method="get" asp-action="Index" data-search-form>
    <div class="search-field">
        <i class="bi bi-search"></i>
        <input type="search" name="search" value="@search" placeholder="Search by name, email or phone…" aria-label="Search members" />
    </div>

    <input type="hidden" name="status" value="@status" />

    <div class="filter-chips">
        <a class="@ChipClass(null)" asp-action="Index" asp-route-search="@search">All</a>
        <a class="@ChipClass("active")" asp-action="Index" asp-route-search="@search" asp-route-status="active">Active</a>
        <a class="@ChipClass("expired")" asp-action="Index" asp-route-search="@search" asp-route-status="expired">Expired</a>
        <a class="@ChipClass("noplan")" asp-action="Index" asp-route-search="@search" asp-route-status="noplan">No Plan</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status)) {
        <a class="btn-app btn-app--ghost btn-app--sm ms-auto" asp-action="Index">
            <i class="bi bi-x-lg"></i> Clear
        </a>
    }
</form>

@if (members.Count > 0) {
    <div class="table-app-wrap">
        <div class="table-app-scroll">
            <table class="table-app">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Contact</th>
                        <th>Gender</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in members) {
                        <tr>
                            <td>
                                <div class="identity">
                                    <partial name="_Avatar" model="@(new AvatarModel { Name = member.Name, Photo = member.Photo, Folder = "members" })" />
                                    <div class="min-width-0">
                                        <div class="identity__name">@member.Name</div>
                                        <div class="identity__meta">#@member.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fs-14">@member.Email</div>
                                <div class="identity__meta mono-num">@member.Phone</div>
                            </td>
                            <td class="text-muted-2">@member.Gender</td>
                            <td>
                                @if (member.PlanName is not null) {
                                    <span class="pill pill--brand"><i class="bi bi-tag"></i>@member.PlanName</span>
                                }
                                else {
                                    <span class="text-subtle fs-14">—</span>
                                }
                            </td>
                            <td><partial name="_StatusPill" model="@member.MembershipStatus" /></td>
                            <td class="text-muted-2 mono-num fs-14">@member.JoinedOn.ToString("MMM dd, yyyy")</td>
                            <td class="col-actions">
                                <div class="dropdown">
                                    <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @member.Name">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-action="MemberDetails" asp-route-id="@member.Id">
                                                <i class="bi bi-person-lines-fill"></i> View profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="HealthRecordDetails" asp-route-id="@member.Id">
                                                <i class="bi bi-clipboard2-pulse"></i> Health record
                                            </a>
                                        </li>
                                        @if (isAdmin) {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a class="dropdown-item" asp-action="EditMember" asp-route-id="@member.Id">
                                                    <i class="bi bi-pencil"></i> Edit details
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-controller="Memberships" asp-action="Create" asp-route-memberId="@member.Id">
                                                    <i class="bi bi-card-checklist"></i> New membership
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@member.Id">
                                                    <i class="bi bi-trash"></i> Delete member
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else {
    <div class="card-app">
        <div class="empty-state">
            <div class="empty-state__icon"><i class="bi bi-people"></i></div>
            @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status)) {
                <h2 class="empty-state__title">No members match that</h2>
                <p class="empty-state__text">Try a different search term, or clear the filters to see everyone.</p>
                <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-x-lg"></i> Clear filters</a>
            }
            else {
                <h2 class="empty-state__title">No members yet</h2>
                <p class="empty-state__text">Add your first member to start tracking subscriptions, health records and class bookings.</p>
                @if (isAdmin) {
                    <a class="btn-app btn-app--primary" asp-action="Create"><i class="bi bi-person-plus"></i> Add Member</a>
                }
            }
        </div>
    </div>
}
