@{
    ViewData["Title"] = "Reset Link Not Valid";
    Layout = "_AuthLayout";
}

<div class="auth-card text-center">
    <div class="empty-state__icon" style="background:var(--warn-100);color:var(--warn-600)">
        <i class="bi bi-link-45deg"></i>
    </div>

    <h1 class="auth-card__title">That link isn't valid</h1>
    <p class="auth-card__sub">
        Reset links are single-use and expire after a day, and some email clients cut long links in
        half. Request a fresh one and it'll work.
    </p>

    <a class="btn-app btn-app--primary btn-app--block" asp-action="ForgotPassword">
        <i class="bi bi-envelope-arrow-up"></i> Request a new link
    </a>
    <a class="btn-app btn-app--ghost btn-app--block mt-2" asp-action="Login">Back to sign in</a>
</div>
