@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose A New Password";
    Layout = "_AuthLayout";
}

<div class="auth-card form-app">
    <h1 class="auth-card__title">Choose a new password</h1>
    <p class="auth-card__sub">Setting a new password for <strong>@Model.Email</strong>.</p>

    <partial name="_ValidationSummary" />

    <form asp-action="ResetPassword" method="post" novalidate>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="••••••••" />
            <span asp-validation-for="Password"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="••••••••" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <div class="field-hint mb-4">
            <i class="bi bi-info-circle me-1"></i>
            At least 6 characters, with one uppercase letter and one digit.
        </div>

        <button type="submit" class="btn-app btn-app--primary btn-app--lg btn-app--block">
            <i class="bi bi-shield-check"></i> Set New Password
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
