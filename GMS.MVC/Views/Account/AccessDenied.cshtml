@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="auth-card text-center">
    <div class="empty-state__icon" style="background:var(--danger-100);color:var(--danger-600)">
        <i class="bi bi-shield-lock"></i>
    </div>

    <h1 class="auth-card__title">You don't have access to that</h1>
    <p class="auth-card__sub">
        Your account doesn't carry the role this page requires. If you believe that's wrong,
        ask an administrator to review your permissions.
    </p>

    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a class="btn-app btn-app--primary" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-house"></i> Back to Dashboard
        </a>
        <form asp-action="Logout" method="post" class="m-0">
            <button type="submit" class="btn-app btn-app--ghost">
                <i class="bi bi-box-arrow-right"></i> Sign Out
            </button>
        </form>
    </div>
</div>
