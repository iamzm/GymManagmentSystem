@{
    ViewData["Title"] = "Password Updated";
    Layout = "_AuthLayout";
}

<div class="auth-card text-center">
    <div class="empty-state__icon" style="background:var(--ok-100);color:var(--ok-600)">
        <i class="bi bi-check2-circle"></i>
    </div>

    <h1 class="auth-card__title">Password updated</h1>
    <p class="auth-card__sub">
        You can sign in with your new password now. If the account was locked after failed
        attempts, that's been cleared too.
    </p>

    <a class="btn-app btn-app--primary btn-app--block" asp-action="Login">
        <i class="bi bi-box-arrow-in-right"></i> Sign In
    </a>
</div>
