@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card form-app">
    <h1 class="auth-card__title">Forgot your password?</h1>
    <p class="auth-card__sub">
        Enter the email address on your account and we'll send you a link to choose a new password.
    </p>

    <partial name="_ValidationSummary" />

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="mb-4">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@example.com" />
            <span asp-validation-for="Email"></span>
        </div>

        <button type="submit" class="btn-app btn-app--primary btn-app--lg btn-app--block">
            <i class="bi bi-envelope-arrow-up"></i> Send Reset Link
        </button>
    </form>

    <p class="text-center mt-4 mb-0 text-muted-2">
        Remembered it? <a asp-action="Login" class="fw-600">Back to sign in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
