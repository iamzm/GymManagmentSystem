@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["Crumb"] = "Update your sign-in credentials";
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">Account</div>
        <h1 class="page-head__title">Change Password</h1>
        <p class="page-head__sub">You'll stay signed in on this device after the change.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card-app form-app">
            <div class="card-app__body">
                <partial name="_ValidationSummary" />

                <form asp-action="ChangePassword" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div class="form-actions">
                        <a class="btn-app btn-app--ghost" asp-action="Profile">Cancel</a>
                        <button type="submit" class="btn-app btn-app--primary">
                            <i class="bi bi-check-lg"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
