@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_AuthLayout";
    var email = ViewBag.Email as string;
}

<div class="auth-card text-center">
    <div class="empty-state__icon" style="background:var(--ok-100);color:var(--ok-600)">
        <i class="bi bi-envelope-check"></i>
    </div>

    <h1 class="auth-card__title">Check your email</h1>
    @* Built as one string so Razor's block whitespace does not leave a gap before the comma. *@
    <p class="auth-card__sub">
        If there's an account for <strong>@(string.IsNullOrWhiteSpace(email) ? "that address" : email)</strong>,
        we've sent a link to reset the password. It's single-use and expires in a day.
    </p>

    <div class="alert-app alert-app--info text-start">
        <i class="bi bi-info-circle-fill"></i>
        <div>
            Nothing arrived? Check the spam folder, and make sure you used the address the account
            was registered with.
        </div>
    </div>

    <a class="btn-app btn-app--primary btn-app--block mt-3" asp-action="Login">
        <i class="bi bi-arrow-left"></i> Back to sign in
    </a>
</div>
