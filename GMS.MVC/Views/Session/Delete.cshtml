@model SessionDTO
@{
    ViewData["Title"] = "Delete Session";
    ViewData["Crumb"] = "This cannot be undone";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card-app">
            <div class="card-app__body text-center">
                <div class="empty-state__icon" style="background:var(--danger-100);color:var(--danger-600)">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h1 class="h4 mb-2">Delete this session?</h1>
                <p class="text-muted-2">The class will be permanently removed from the timetable.</p>

                <div class="my-4 p-3 rounded-3 text-start" style="background:var(--surface-sunken)">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="fw-600 h6 mb-0">@Model.CategoryName</span>
                        <partial name="_StatusPill" model="@Model.Status" />
                    </div>
                    <div class="fs-14 text-muted-2 d-grid gap-1">
                        <span><i class="bi bi-person-circle me-2"></i>@Model.TrainerName</span>
                        <span class="mono-num"><i class="bi bi-calendar3 me-2"></i>@Model.DateDisplay · @Model.TimeRangeDisplay</span>
                        <span class="mono-num"><i class="bi bi-people me-2"></i>@Model.BookedSlots / @Model.Capacity seats booked</span>
                    </div>
                </div>

                @if (!Model.CanModify) {
                    <div class="alert-app alert-app--danger text-start">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            This session has already started or has bookings against it, so the
                            delete will be refused. Cancel its bookings first.
                        </div>
                    </div>
                }

                <form asp-action="DeleteSession" method="post" class="d-flex gap-2 mt-4">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <a class="btn-app btn-app--ghost flex-fill" asp-action="Index">Keep session</a>
                    <button type="submit" class="btn-app btn-app--danger-solid flex-fill">
                        <i class="bi bi-trash"></i> Delete permanently
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
