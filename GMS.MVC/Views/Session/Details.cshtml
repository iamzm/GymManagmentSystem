@model SessionDTO
@{
    ViewData["Title"] = Model.CategoryName;
    ViewData["Crumb"] = "Session details";
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var meterClass = Model.FillPercent >= 100 ? "meter--danger" : Model.FillPercent >= 75 ? "meter--warn" : "meter--ok";
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">Operations · Sessions</div>
        <h1 class="page-head__title">@Model.CategoryName</h1>
        <p class="page-head__sub">@Model.DayDisplay, @Model.DateDisplay · @Model.TimeRangeDisplay</p>
    </div>
    <div class="page-head__actions">
        <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to list</a>
        <a class="btn-app btn-app--soft" asp-controller="SessionsSchedule" asp-action="Roster" asp-route-id="@Model.Id">
            <i class="bi bi-people"></i> Manage roster
        </a>
        @if (isAdmin && Model.CanModify) {
            <a class="btn-app btn-app--primary" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card-app mb-4">
            <div class="card-app__head">
                <span class="icon-chip"><i class="bi bi-activity"></i></span>
                <div>
                    <h2 class="card-app__title">@Model.CategoryName</h2>
                    <p class="card-app__sub">Led by @Model.TrainerName</p>
                </div>
                <span class="ms-auto"><partial name="_StatusPill" model="@Model.Status" /></span>
            </div>
            <div class="card-app__body">
                <p class="mb-4">@Model.Description</p>

                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-item__label">Trainer</div>
                        <div class="detail-item__value">@Model.TrainerName</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Date</div>
                        <div class="detail-item__value">@Model.DayDisplay, @Model.DateDisplay</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Time</div>
                        <div class="detail-item__value mono-num">@Model.TimeRangeDisplay</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Duration</div>
                        <div class="detail-item__value">@Model.DurationDisplay</div>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.CanModify && isAdmin) {
            <div class="alert-app alert-app--info">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    This session can no longer be edited or deleted — it has already started, or
                    members have booked seats in it.
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-lg-4">
        <div class="card-app">
            <div class="card-app__head">
                <span class="icon-chip"><i class="bi bi-people"></i></span>
                <div><h2 class="card-app__title">Capacity</h2></div>
            </div>
            <div class="card-app__body text-center">
                <div class="stat-tile__value">@Model.BookedSlots<span class="text-subtle fs-4"> / @Model.Capacity</span></div>
                <div class="stat-tile__label mb-3">Seats booked</div>

                <div class="meter @meterClass mb-2">
                    <div class="meter__fill" style="width:@(Model.FillPercent)%"></div>
                </div>

                <div class="fs-14 text-muted-2">
                    @if (Model.IsFull) {
                        <span class="pill pill--danger"><i class="bi bi-slash-circle"></i>Fully booked</span>
                    }
                    else {
                        <span><span class="mono-num fw-600">@Model.AvailableSlots</span> @(Model.AvailableSlots == 1 ? "seat" : "seats") still available</span>
                    }
                </div>
            </div>
            <div class="card-app__foot">
                <a class="btn-app btn-app--ghost btn-app--block btn-app--sm" asp-controller="SessionsSchedule" asp-action="Roster" asp-route-id="@Model.Id">
                    <i class="bi bi-list-check"></i> View who's booked
                </a>
            </div>
        </div>
    </div>
</div>
