@model IEnumerable<SessionDTO>
@{
    ViewData["Title"] = "Sessions";
    ViewData["Crumb"] = "Every class on record";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var sessions = Model?.ToList() ?? [];
    var isAdmin = User.IsInRole(AppRoles.Admin);

    string ChipClass(string? value) => string.Equals(status, value, StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrEmpty(status) && value is null) ? "chip is-active" : "chip";
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">Operations</div>
        <h1 class="page-head__title">Training Sessions</h1>
        <p class="page-head__sub">@sessions.Count session@(sessions.Count == 1 ? "" : "s") shown · @sessions.Count(S => S.Status == "Upcoming") upcoming</p>
    </div>
    <div class="page-head__actions">
        <a class="btn-app btn-app--ghost" asp-controller="SessionsSchedule" asp-action="Index">
            <i class="bi bi-calendar-week"></i> Timetable
        </a>
        @if (isAdmin) {
            <a class="btn-app btn-app--primary" asp-action="Create">
                <i class="bi bi-calendar-plus"></i> Add Session
            </a>
        }
    </div>
</div>

<form class="toolbar" method="get" asp-action="Index" data-search-form>
    <div class="search-field">
        <i class="bi bi-search"></i>
        <input type="search" name="search" value="@search" placeholder="Search by class, trainer or description…" aria-label="Search sessions" />
    </div>

    <input type="hidden" name="status" value="@status" />

    <div class="filter-chips">
        <a class="@ChipClass(null)" asp-action="Index" asp-route-search="@search">All</a>
        <a class="@ChipClass("Upcoming")" asp-action="Index" asp-route-search="@search" asp-route-status="Upcoming">Upcoming</a>
        <a class="@ChipClass("Ongoing")" asp-action="Index" asp-route-search="@search" asp-route-status="Ongoing">Ongoing</a>
        <a class="@ChipClass("Completed")" asp-action="Index" asp-route-search="@search" asp-route-status="Completed">Completed</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status)) {
        <a class="btn-app btn-app--ghost btn-app--sm ms-auto" asp-action="Index">
            <i class="bi bi-x-lg"></i> Clear
        </a>
    }
</form>

@if (sessions.Count > 0) {
    <div class="row g-4">
        @foreach (var session in sessions) {
            var meterClass = session.FillPercent >= 100 ? "meter--danger" : session.FillPercent >= 75 ? "meter--warn" : "meter--ok";
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card-app card-app--hover h-100 d-flex flex-column">
                    <div class="card-app__body flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="icon-chip"><i class="bi bi-activity"></i></span>
                            <partial name="_StatusPill" model="@session.Status" />
                        </div>

                        <h2 class="h5 mb-1">@session.CategoryName</h2>
                        <p class="text-muted-2 fs-14">@session.Description</p>

                        <div class="d-grid gap-2 fs-14 text-muted-2 mb-3">
                            <span><i class="bi bi-person-circle me-2 text-brand"></i>@session.TrainerName</span>
                            <span class="mono-num"><i class="bi bi-calendar3 me-2 text-brand"></i>@session.DayDisplay, @session.DateDisplay</span>
                            <span class="mono-num"><i class="bi bi-clock me-2 text-brand"></i>@session.TimeRangeDisplay · @session.DurationDisplay</span>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between fs-13 text-muted-2 mb-1">
                                <span>Seats booked</span>
                                <span class="mono-num fw-600">@session.BookedSlots / @session.Capacity</span>
                            </div>
                            <div class="meter @meterClass">
                                <div class="meter__fill" style="width:@(session.FillPercent)%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="card-app__foot d-flex gap-2">
                        <a class="btn-app btn-app--ghost btn-app--sm flex-fill" asp-action="Details" asp-route-id="@session.Id">
                            <i class="bi bi-eye"></i> Details
                        </a>
                        <a class="btn-app btn-app--soft btn-app--sm flex-fill" asp-controller="SessionsSchedule" asp-action="Roster" asp-route-id="@session.Id">
                            <i class="bi bi-people"></i> Roster
                        </a>
                        @if (isAdmin && session.CanModify) {
                            <a class="btn-app btn-app--ghost btn-app--sm btn-icon-only" asp-action="Edit" asp-route-id="@session.Id" title="Edit session">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn-app btn-app--danger btn-app--sm btn-icon-only" asp-action="Delete" asp-route-id="@session.Id" title="Delete session">
                                <i class="bi bi-trash"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else {
    <div class="card-app">
        <div class="empty-state">
            <div class="empty-state__icon"><i class="bi bi-calendar-x"></i></div>
            @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status)) {
                <h2 class="empty-state__title">No sessions match that</h2>
                <p class="empty-state__text">Try a different search term, or clear the filters.</p>
                <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-x-lg"></i> Clear filters</a>
            }
            else {
                <h2 class="empty-state__title">No sessions yet</h2>
                <p class="empty-state__text">Schedule your first class to start taking bookings.</p>
                @if (isAdmin) {
                    <a class="btn-app btn-app--primary" asp-action="Create"><i class="bi bi-calendar-plus"></i> Add Session</a>
                }
            }
        </div>
    </div>
}
