@model ExpenseDTO
@{
    ViewData["Title"] = "Remove Expense";
    ViewData["Crumb"] = "Confirm removal";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card-app">
            <div class="card-app__body text-center">
                <div class="empty-state__icon" style="background:var(--danger-100);color:var(--danger-ink)">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h1 class="h4 mt-3">Remove this expense?</h1>
                <p class="text-muted-2">
                    @Money.Format(Model.Amount) will come back out of the @Model.SpentOn.ToString("MMMM yyyy")
                    totals and the Profit &amp; Loss figures.
                </p>

                <div class="card-app mt-3 mb-4 text-start">
                    <div class="card-app__body">
                        <div class="detail-grid">
                            <div class="detail-item detail-item--wide">
                                <div class="detail-item__label">Title</div>
                                <div class="detail-item__value">@Model.Title</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-item__label">Category</div>
                                <div class="detail-item__value">@Model.Category</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-item__label">Amount</div>
                                <div class="detail-item__value mono-num">@Money.Format(Model.Amount)</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-item__label">Spent on</div>
                                <div class="detail-item__value">@Model.SpentOn.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-item__label">Vendor</div>
                                <div class="detail-item__value">@(string.IsNullOrWhiteSpace(Model.Vendor) ? "—" : Model.Vendor)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="DeleteExpense" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 justify-content-center">
                    <a class="btn-app btn-app--ghost" asp-action="Index">Cancel</a>
                    <button type="submit" data-pending-label="Removing…" class="btn-app btn-app--danger-solid">
                        <i class="bi bi-trash"></i> Remove Expense
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
