@model CreateExpenseDTO
@* Shared by Create and Edit so the two cannot drift apart. *@

<div class="form-section">
    <div class="form-section__title"><i class="bi bi-receipt"></i> What was it for?</div>
    <div class="row g-3">
        <div class="col-12 col-md-7">
            <label asp-for="Title">Title <span class="req">*</span></label>
            <input asp-for="Title" class="form-control" placeholder="December rent · Electricity bill · New dumbbells" />
            <span asp-validation-for="Title"></span>
        </div>
        <div class="col-12 col-md-5">
            <label asp-for="Category">Category <span class="req">*</span></label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<ExpenseCategory>()" class="form-select">
                <option value="">Select a category</option>
            </select>
            <span asp-validation-for="Category"></span>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section__title"><i class="bi bi-cash-coin"></i> Payment</div>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <label asp-for="Amount">Amount (@Money.Code) <span class="req">*</span></label>
            <input asp-for="Amount" type="number" step="1" min="1" class="form-control" placeholder="120000" />
            <span asp-validation-for="Amount"></span>
        </div>
        <div class="col-12 col-md-4">
            <label asp-for="SpentOn">Spent On <span class="req">*</span></label>
            <input asp-for="SpentOn" type="date" class="form-control" />
            <div class="field-hint">The date the money left, which is what the monthly figures use.</div>
            <span asp-validation-for="SpentOn"></span>
        </div>
        <div class="col-12 col-md-4">
            <label asp-for="PaymentMethod">Paid By <span class="req">*</span></label>
            <select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select">
                <option value="">Select a method</option>
            </select>
            <span asp-validation-for="PaymentMethod"></span>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section__title"><i class="bi bi-journal-text"></i> Paperwork</div>
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label asp-for="Vendor">Vendor</label>
            <input asp-for="Vendor" class="form-control" placeholder="K-Electric · Fitness World" />
            <span asp-validation-for="Vendor"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Reference">Invoice / Reference</label>
            <input asp-for="Reference" class="form-control" placeholder="INV-2026-0142" />
            <span asp-validation-for="Reference"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes">Notes</label>
            <input asp-for="Notes" class="form-control" placeholder="Optional detail for later" />
            <span asp-validation-for="Notes"></span>
        </div>
    </div>
</div>
