@model EmployeeDTO
@{
    ViewData["Title"] = Model.Name;
    ViewData["Crumb"] = "Staff profile";
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">People · Employees</div>
        <h1 class="page-head__title">@Model.Name</h1>
        <p class="page-head__sub">@Model.JobTitle · @Model.EmploymentType</p>
    </div>
    <div class="page-head__actions">
        <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to list</a>
        <a class="btn-app btn-app--primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="card-app">
            <div class="card-app__body text-center">
                <div class="d-flex justify-content-center mb-3">
                    <partial name="_Avatar" model="@(new AvatarModel { Name = Model.Name, Photo = Model.Photo, Folder = "employees", Size = "xl" })" />
                </div>
                <h2 class="h5 mb-1">@Model.Name</h2>
                <p class="text-muted-2 mb-3">@Model.JobTitle</p>

                @if (Model.IsActive) {
                    <span class="pill pill--ok"><i class="bi bi-check-circle-fill"></i>Employed</span>
                }
                else {
                    <span class="pill pill--muted"><i class="bi bi-box-arrow-right"></i>Former employee</span>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card-app mb-4">
            <div class="card-app__head"><h2 class="card-app__title"><i class="bi bi-briefcase"></i> Employment</h2></div>
            <div class="card-app__body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-item__label">Job title</div>
                        <div class="detail-item__value">@Model.JobTitle</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Employment type</div>
                        <div class="detail-item__value">@Model.EmploymentType</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Monthly salary</div>
                        <div class="detail-item__value mono-num">@Money.Format(Model.MonthlySalary)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Hired on</div>
                        <div class="detail-item__value">@Model.HiredOn.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Time served</div>
                        <div class="detail-item__value">@Model.YearsOfService year@(Model.YearsOfService == 1 ? "" : "s")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-app">
            <div class="card-app__head"><h2 class="card-app__title"><i class="bi bi-person-vcard"></i> Contact</h2></div>
            <div class="card-app__body">
                <div class="detail-grid">
                    <div class="detail-item detail-item--wide">
                        <div class="detail-item__label">Email</div>
                        <div class="detail-item__value">@Model.Email</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Phone</div>
                        <div class="detail-item__value mono-num">@Model.Phone</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Date of birth</div>
                        <div class="detail-item__value">@Model.DateOfBirth</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-item__label">Gender</div>
                        <div class="detail-item__value">@Model.Gender</div>
                    </div>
                    <div class="detail-item detail-item--wide">
                        <div class="detail-item__label">Address</div>
                        <div class="detail-item__value">@Model.Address</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
