@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_PublicLayout";
}

<section class="container py-5">
    <div class="card-app" style="max-width:620px;margin-inline:auto">
        <div class="empty-state">
            <div class="empty-state__icon" style="background:var(--danger-100);color:var(--danger-600)">
                <i class="bi bi-exclamation-octagon"></i>
            </div>
            <h1 class="empty-state__title">Something went wrong</h1>
            <p class="empty-state__text">
                An unexpected error occurred while processing your request. Please try again —
                if it keeps happening, let an administrator know.
            </p>

            @if (Model.ShowRequestId) {
                <p class="fs-13 text-subtle">
                    Request ID: <code class="mono-num">@Model.RequestId</code>
                </p>
            }

            <a class="btn-app btn-app--primary" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house"></i> Go Home
            </a>
        </div>
    </div>
</section>
