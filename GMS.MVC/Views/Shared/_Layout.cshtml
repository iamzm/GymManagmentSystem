@using Presistence.Identity
@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    // The display name rides along in the auth cookie, so rendering the shell costs no query.
    var displayName = User.FindFirstValue(AppUserClaimsPrincipalFactory.FullNameClaim)
                      ?? User.Identity?.Name ?? "Guest";
    var role = User.IsInRole(AppRoles.Admin) ? "Administrator"
             : User.IsInRole(AppRoles.Trainer) ? "Trainer"
             : "Member";
    var isStaff = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Trainer);
    var isAdmin = User.IsInRole(AppRoles.Admin);

    string NavClass(string controller) => currentController == controller ? "nav-item is-active" : "nav-item";

    string Initials(string name) {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Dashboard") · Power Fitness</title>
    <link rel="shortcut icon" href="~/images/icon.svg" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script>
        // Applied before first paint so the page never flashes the wrong theme.
        (function () {
            try {
                var t = localStorage.getItem('pf-theme');
                if (t) document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>
</head>

<body>
    <div class="app-shell">

        <aside class="sidebar">
            <a class="sidebar__brand text-decoration-none" asp-controller="Dashboard" asp-action="Index">
                <span class="sidebar__logo"><i class="bi bi-lightning-charge-fill"></i></span>
                <span>
                    <span class="sidebar__title d-block">Power Fitness</span>
                    <span class="sidebar__subtitle">Gym Management</span>
                </span>
            </a>

            <nav class="sidebar__nav">
                <div class="sidebar__section">Overview</div>
                @* Members have no back-office figures to see, and the dashboard would only bounce
                   them straight back to the schedule — so it is not offered to them. *@
                @if (isStaff) {
                    <a class="@NavClass("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                    </a>
                }
                <a class="@NavClass("SessionsSchedule")" asp-controller="SessionsSchedule" asp-action="Index">
                    <i class="bi bi-calendar-week"></i><span>Schedule</span>
                </a>

                @if (isStaff) {
                    <div class="sidebar__section">People</div>
                    <a class="@NavClass("Members")" asp-controller="Members" asp-action="Index">
                        <i class="bi bi-people"></i><span>Members</span>
                    </a>
                    <a class="@NavClass("Trainers")" asp-controller="Trainers" asp-action="Index">
                        <i class="bi bi-person-badge"></i><span>Trainers</span>
                    </a>

                    <div class="sidebar__section">Operations</div>
                    <a class="@NavClass("Session")" asp-controller="Session" asp-action="Index">
                        <i class="bi bi-activity"></i><span>Sessions</span>
                    </a>
                    <a class="@NavClass("Memberships")" asp-controller="Memberships" asp-action="Index">
                        <i class="bi bi-card-checklist"></i><span>Memberships</span>
                    </a>
                }

                <div class="sidebar__section">Catalogue</div>
                <a class="@NavClass("Plans")" asp-controller="Plans" asp-action="Index">
                    <i class="bi bi-tags"></i><span>Plans</span>
                </a>

                <div class="sidebar__section">Account</div>
                <a class="@NavClass("MyMembership")" asp-controller="MyMembership" asp-action="Index">
                    <i class="bi bi-person-vcard"></i><span>My Plan</span>
                </a>
                <a class="@NavClass("Account")" asp-controller="Account" asp-action="Profile">
                    <i class="bi bi-person-circle"></i><span>My Profile</span>
                </a>
                <a class="nav-item" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-globe2"></i><span>Public Site</span>
                </a>
            </nav>

            <div class="sidebar__footer">
                <div class="sidebar__user">
                    <span class="avatar-app avatar-app--sm">@Initials(displayName)</span>
                    <span class="flex-grow-1 overflow-hidden">
                        <span class="sidebar__user-name d-block text-truncate">@displayName</span>
                        <span class="sidebar__user-role">@role</span>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn border-0 p-1 text-white-50" title="Sign out">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="sidebar-backdrop"></div>

        <div class="app-main">
            <header class="topbar">
                <button class="icon-btn d-lg-none" type="button" data-sidebar-toggle aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>

                <div class="min-width-0">
                    <p class="topbar__title mb-0">@(ViewData["Title"] ?? "Dashboard")</p>
                    <span class="topbar__crumb">@(ViewData["Crumb"] ?? "Power Fitness back office")</span>
                </div>

                <div class="topbar__actions">
                    <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
                        <i class="bi bi-moon-stars"></i>
                    </button>

                    @if (isAdmin) {
                        <div class="dropdown">
                            <button class="btn-app btn-app--primary btn-app--sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-plus-lg"></i> New
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Members" asp-action="Create"><i class="bi bi-person-plus"></i> Member</a></li>
                                <li><a class="dropdown-item" asp-controller="Trainers" asp-action="Create"><i class="bi bi-person-badge"></i> Trainer</a></li>
                                <li><a class="dropdown-item" asp-controller="Session" asp-action="Create"><i class="bi bi-calendar-plus"></i> Session</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Memberships" asp-action="Create"><i class="bi bi-card-checklist"></i> Membership</a></li>
                            </ul>
                        </div>
                    }
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_Toasts" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
