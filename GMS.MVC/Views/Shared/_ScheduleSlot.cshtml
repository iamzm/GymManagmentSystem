@model ScheduleSlotDTO
@* The inside of a timetable card. Shared so the staff (link) and member (static) variants
   can't drift apart. *@
<div class="slot-card__time">@Model.TimeRange</div>
<div class="slot-card__title">@Model.CategoryName</div>
<div class="slot-card__meta">
    <i class="bi bi-person"></i>@Model.TrainerName
</div>
<div class="slot-card__meta mt-1">
    <i class="bi bi-people"></i>
    <span class="mono-num">@Model.BookedSlots/@Model.Capacity</span>
    @if (Model.IsFull) {
        <span class="pill pill--danger ms-1" style="padding:0 7px">Full</span>
    }
</div>
