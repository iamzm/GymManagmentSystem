<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Sign In") · Power Fitness</title>
    <link rel="shortcut icon" href="~/images/icon.svg" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var t = localStorage.getItem('pf-theme');
                if (t) document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>
</head>

<body>
    <div class="auth-page">
        <aside class="auth-page__aside">
            <a class="auth-page__brand text-decoration-none" asp-controller="Home" asp-action="Index">
                <span class="sidebar__logo"><i class="bi bi-lightning-charge-fill"></i></span>
                <span>
                    <span class="sidebar__title d-block">Power Fitness</span>
                    <span class="sidebar__subtitle">Gym Management</span>
                </span>
            </a>

            <div>
                <h1 class="auth-page__headline">Your body can stand almost anything.</h1>
                <p class="auth-page__lede">
                    Members, trainers, classes, plans and bookings — the whole gym in one place,
                    with live numbers you can actually act on.
                </p>
            </div>

            <div class="auth-page__stats">
                <div>
                    <div class="auth-page__stat-value">7</div>
                    <div class="auth-page__stat-label">Modules</div>
                </div>
                <div>
                    <div class="auth-page__stat-value">3</div>
                    <div class="auth-page__stat-label">Access roles</div>
                </div>
                <div>
                    <div class="auth-page__stat-value">24/7</div>
                    <div class="auth-page__stat-label">Live analytics</div>
                </div>
            </div>
        </aside>

        <section class="auth-page__form">
            @RenderBody()
        </section>
    </div>

    <partial name="_Toasts" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
