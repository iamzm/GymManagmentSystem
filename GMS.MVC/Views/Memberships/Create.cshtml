@model CreateMembershipDTO
@{
    ViewData["Title"] = "New Membership";
    ViewData["Crumb"] = "Subscribe a member to a plan";
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">Operations · Memberships</div>
        <h1 class="page-head__title">New membership</h1>
        <p class="page-head__sub">The end date is worked out from the plan's duration — you only choose when it starts.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to list</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card-app form-app">
            <div class="card-app__body">
                <partial name="_ValidationSummary" />

                <form asp-action="Create" method="post" novalidate>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="MemberId">Member <span class="req">*</span></label>
                            <select asp-for="MemberId" asp-items="@ViewBag.Members" class="form-select">
                                <option value="">Select a member…</option>
                            </select>
                            <div class="field-hint">A member can only hold one active contract at a time — renew instead of adding a second.</div>
                            <span asp-validation-for="MemberId"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="PlanId">Plan <span class="req">*</span></label>
                            <select asp-for="PlanId" asp-items="@ViewBag.Plans" class="form-select">
                                <option value="">Select a plan…</option>
                            </select>
                            <div class="field-hint">Only plans currently on sale are listed.</div>
                            <span asp-validation-for="PlanId"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="StartDate">Start Date <span class="req">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate"></span>
                        </div>
                    </div>

                    <div class="alert-app alert-app--info mt-4">
                        <i class="bi bi-info-circle-fill"></i>
                        <div>
                            The plan's price at the moment of sale is copied onto the contract, so a later
                            price change never rewrites what this member paid.
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-app btn-app--ghost" asp-action="Index">Cancel</a>
                        <button type="submit" class="btn-app btn-app--primary">
                            <i class="bi bi-check-lg"></i> Create Membership
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
