@model CreateInventoryItemDTO
@{
    ViewData["Title"] = "Add Item";
    ViewData["Crumb"] = "Add equipment or stock";
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">Operations · Inventory</div>
        <h1 class="page-head__title">Add an item</h1>
        <p class="page-head__sub">Equipment is tracked by condition and service date; stock by quantity and reorder level.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to list</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card-app form-app">
            <div class="card-app__body">
                <partial name="_ValidationSummary" />

                <form asp-action="CreateItem" method="post" novalidate>
                    <partial name="_InventoryFields" model="Model" />

                    <div class="form-actions">
                        <a class="btn-app btn-app--ghost" asp-action="Index">Cancel</a>
                        <button type="submit" data-pending-label="Saving item…" class="btn-app btn-app--primary">
                            <i class="bi bi-check2"></i> Save Item
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
