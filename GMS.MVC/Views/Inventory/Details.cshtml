@model InventoryItemDTO
@{
    ViewData["Title"] = Model.Name;
    ViewData["Crumb"] = "Inventory item";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="page-head">
    <div>
        <div class="page-head__eyebrow">Operations · Inventory</div>
        <h1 class="page-head__title">@Model.Name</h1>
        <p class="page-head__sub">@Model.Kind · @Model.Quantity in hand · @Money.Format(Model.TotalValue) held</p>
    </div>
    <div class="page-head__actions">
        <a class="btn-app btn-app--ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to list</a>
        @if (isAdmin) {
            <a class="btn-app btn-app--primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
        }
    </div>
</div>

@if (Model.IsLowStock) {
    <div class="alert-app alert-app--danger mb-4">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            <strong>Running low.</strong>
            @Model.Quantity left against a reorder level of @Model.ReorderLevel. Time to restock.
        </div>
    </div>
}
else if (Model.IsServiceOverdue) {
    <div class="alert-app alert-app--danger mb-4">
        <i class="bi bi-tools"></i>
        <div>
            <strong>Service overdue.</strong>
            This was due for service on @Model.NextServiceOn!.Value.ToString("MMM dd, yyyy").
        </div>
    </div>
}
else if (Model.IsServiceDueSoon) {
    <div class="alert-app alert-app--warn mb-4">
        <i class="bi bi-tools"></i>
        <div>
            <strong>Service due soon.</strong>
            Booked in for @Model.NextServiceOn!.Value.ToString("MMM dd, yyyy").
        </div>
    </div>
}

<div class="card-app">
    <div class="card-app__head"><h2 class="card-app__title"><i class="bi bi-info-circle"></i> Item details</h2></div>
    <div class="card-app__body">
        <div class="detail-grid">
            <div class="detail-item detail-item--wide">
                <div class="detail-item__label">Description</div>
                <div class="detail-item__value">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</div>
            </div>
            <div class="detail-item">
                <div class="detail-item__label">Kind</div>
                <div class="detail-item__value">@Model.Kind</div>
            </div>
            <div class="detail-item">
                <div class="detail-item__label">Quantity</div>
                <div class="detail-item__value mono-num">@Model.Quantity</div>
            </div>
            <div class="detail-item">
                <div class="detail-item__label">Unit cost</div>
                <div class="detail-item__value mono-num">@Money.Format(Model.UnitCost)</div>
            </div>
            <div class="detail-item">
                <div class="detail-item__label">Total value</div>
                <div class="detail-item__value mono-num">@Money.Format(Model.TotalValue)</div>
            </div>
            <div class="detail-item">
                <div class="detail-item__label">Supplier</div>
                <div class="detail-item__value">@(string.IsNullOrWhiteSpace(Model.Supplier) ? "—" : Model.Supplier)</div>
            </div>
            <div class="detail-item">
                <div class="detail-item__label">Purchased on</div>
                <div class="detail-item__value">@(Model.PurchasedOn?.ToString("MMM dd, yyyy") ?? "—")</div>
            </div>

            @if (Model.IsEquipment) {
                <div class="detail-item">
                    <div class="detail-item__label">Location</div>
                    <div class="detail-item__value">@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</div>
                </div>
                <div class="detail-item">
                    <div class="detail-item__label">Condition</div>
                    <div class="detail-item__value">@(Model.Condition ?? "—")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-item__label">Next service</div>
                    <div class="detail-item__value">@(Model.NextServiceOn?.ToString("MMM dd, yyyy") ?? "—")</div>
                </div>
            }
            else {
                <div class="detail-item">
                    <div class="detail-item__label">Reorder level</div>
                    <div class="detail-item__value mono-num">@(Model.ReorderLevel?.ToString() ?? "—")</div>
                </div>
            }
        </div>
    </div>
</div>
