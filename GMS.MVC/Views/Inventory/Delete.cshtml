@model InventoryItemDTO
@{
    ViewData["Title"] = "Remove Item";
    ViewData["Crumb"] = "Confirm removal";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card-app">
            <div class="card-app__body text-center">
                <div class="empty-state__icon" style="background:var(--danger-100);color:var(--danger-ink)">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h1 class="h4 mt-3">Remove @Model.Name?</h1>
                <p class="text-muted-2">
                    This deletes the item and the @Money.Format(Model.TotalValue) it represents from the
                    inventory. Purchases already recorded under Expenses are untouched.
                </p>

                <div class="card-app mt-3 mb-4 text-start">
                    <div class="card-app__body">
                        <div class="detail-grid">
                            <div class="detail-item">
                                <div class="detail-item__label">Kind</div>
                                <div class="detail-item__value">@Model.Kind</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-item__label">Quantity</div>
                                <div class="detail-item__value mono-num">@Model.Quantity</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-item__label">Unit cost</div>
                                <div class="detail-item__value mono-num">@Money.Format(Model.UnitCost)</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-item__label">Total value</div>
                                <div class="detail-item__value mono-num">@Money.Format(Model.TotalValue)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="DeleteItem" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 justify-content-center">
                    <a class="btn-app btn-app--ghost" asp-action="Index">Cancel</a>
                    <button type="submit" data-pending-label="Removing…" class="btn-app btn-app--danger-solid">
                        <i class="bi bi-trash"></i> Remove Item
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
