@model LandingViewModel
@{
    ViewData["Title"] = "Home";
    Layout = "_PublicLayout";
    var stats = Model.Stats;
}

@* ---------- Hero ---------- *@
<section class="container">
    <div class="hero row align-items-center g-4">
        <div class="col-12 col-lg-7">
            <span class="hero__eyebrow">
                <i class="bi bi-lightning-charge-fill"></i> Outdoor &amp; online training · Live classes
            </span>

            <h1 class="hero__title">
                Your body can <span>stand almost</span> anything
            </h1>

            <p class="hero__lede">
                It's your mind that needs convincing. Push past your limits, stay committed, and watch
                your body transform into a powerhouse of strength and resilience.
            </p>

            <div class="hero__stats">
                <div class="hero__stat">
                    <div class="hero__stat-value">@stats.TotalMembers</div>
                    <div class="hero__stat-label">Members training</div>
                </div>
                <div class="hero__stat">
                    <div class="hero__stat-value">@stats.TotalTrainers</div>
                    <div class="hero__stat-label">Certified trainers</div>
                </div>
                <div class="hero__stat">
                    <div class="hero__stat-value">@stats.UpcomingSessions</div>
                    <div class="hero__stat-label">Classes coming up</div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3">
                <a class="btn-app btn-app--primary btn-app--lg" asp-controller="Account" asp-action="Register">
                    <i class="bi bi-rocket-takeoff"></i> Get Started
                </a>
                <a class="btn-app btn-app--ghost btn-app--lg" href="#classes">
                    <i class="bi bi-calendar-week"></i> Explore Classes
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="hero__art">
                <img src="~/images/Theo Vance.jpg" alt="Power Fitness trainer" />
            </div>
        </div>
    </div>
</section>

@* ---------- Marquee ---------- *@
<section class="container mb-5">
    <div class="marquee">
        <div class="marquee__track">
            <span>
                outdoor &amp; online trainers <i class="bi bi-asterisk"></i>
                personal training <i class="bi bi-asterisk"></i>
                live classes <i class="bi bi-asterisk"></i>
                nutrition coaching <i class="bi bi-asterisk"></i>
            </span>
            <span aria-hidden="true">
                outdoor &amp; online trainers <i class="bi bi-asterisk"></i>
                personal training <i class="bi bi-asterisk"></i>
                live classes <i class="bi bi-asterisk"></i>
                nutrition coaching <i class="bi bi-asterisk"></i>
            </span>
        </div>
    </div>
</section>

@* ---------- About ---------- *@
<section class="container py-5" id="about">
    <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-6">
            <span class="section-eyebrow"><i class="bi bi-dribbble"></i> About Us</span>
            <h2 class="section-title">Empowering you to achieve <span class="text-brand">your fitness</span> goals</h2>
            <p class="text-muted-2 mb-4" style="font-size:16px">
                Fitness is more than a workout — it's a lifestyle. With serious equipment, certified
                trainers and a community that shows up, we're here to guide every step of the way.
            </p>

            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <div class="feature-card">
                        <div class="feature-card__icon"><i class="bi bi-person-arms-up"></i></div>
                        <h3 class="h6 fw-bold">Personal Trainers</h3>
                        <p class="text-muted-2 fs-14 mb-0">One-to-one programming built around your goals and your schedule.</p>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="feature-card">
                        <div class="feature-card__icon"><i class="bi bi-people"></i></div>
                        <h3 class="h6 fw-bold">Group Classes</h3>
                        <p class="text-muted-2 fs-14 mb-0">Boxing, CrossFit, yoga and conditioning — capped so everyone gets coached.</p>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="feature-card">
                        <div class="feature-card__icon"><i class="bi bi-clipboard2-pulse"></i></div>
                        <h3 class="h6 fw-bold">Health Tracking</h3>
                        <p class="text-muted-2 fs-14 mb-0">Height, weight, blood type and notes kept on file for safe programming.</p>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="feature-card">
                        <div class="feature-card__icon"><i class="bi bi-calendar2-check"></i></div>
                        <h3 class="h6 fw-bold">Easy Booking</h3>
                        <p class="text-muted-2 fs-14 mb-0">Reserve your seat in any class and never turn up to a full room.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="row g-3">
                <div class="col-6">
                    @* The plate is painted in CSS rather than baked into the file, so the image
                       follows the brand colour instead of pinning it. *@
                    <div class="about-plate">
                        <img src="~/images/about-p1.png" alt="Training at Power Fitness" />
                    </div>
                </div>
                <div class="col-6">
                    <img src="~/images/about p2.jpg" class="img-fluid rounded-4 shadow-sm w-100 mb-3" alt="Strength training" />
                    <img src="~/images/about p3.jpg" class="img-fluid rounded-4 shadow-sm w-100" alt="Group class" />
                </div>
            </div>
        </div>
    </div>
</section>

@* ---------- Upcoming classes ---------- *@
<section class="container py-5" id="classes">
    <div class="text-center mb-5">
        <span class="section-eyebrow"><i class="bi bi-activity"></i> This Week</span>
        <h2 class="section-title">Classes coming up</h2>
        <p class="text-muted-2 mb-0">Straight from the timetable — these are real sessions with real seats left.</p>
    </div>

    @if (Model.UpcomingClasses.Count > 0) {
        <div class="row g-4">
            @foreach (var session in Model.UpcomingClasses) {
                <div class="col-12 col-md-4">
                    <div class="card-app card-app--hover h-100">
                        <div class="card-app__body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="icon-chip"><i class="bi bi-calendar-event"></i></span>
                                <partial name="_StatusPill" model="@session.Status" />
                            </div>

                            <h3 class="h5 mb-1">@session.CategoryName</h3>
                            <p class="text-muted-2 fs-14">@session.Description</p>

                            <div class="d-grid gap-2 fs-14 text-muted-2">
                                <span><i class="bi bi-person-circle me-2 text-brand"></i>@session.TrainerName</span>
                                <span><i class="bi bi-calendar3 me-2 text-brand"></i>@session.StartDate.ToString("dddd, MMM dd")</span>
                                <span><i class="bi bi-clock me-2 text-brand"></i>@session.TimeRange</span>
                            </div>
                        </div>
                        <div class="card-app__foot d-flex align-items-center justify-content-between">
                            <span class="fs-14 text-muted-2 mono-num">@session.AvailableSlots of @session.Capacity seats left</span>
                            <a class="btn-app btn-app--soft btn-app--sm" asp-controller="Account" asp-action="Login">Book</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else {
        <div class="card-app">
            <div class="empty-state">
                <div class="empty-state__icon"><i class="bi bi-calendar-x"></i></div>
                <h3 class="empty-state__title">No classes on the timetable yet</h3>
                <p class="empty-state__text">New sessions are added every week — check back soon or sign in to see the full schedule.</p>
            </div>
        </div>
    }
</section>

@* ---------- Plans ---------- *@
<section class="container py-5" id="plans">
    <div class="text-center mb-5">
        <span class="section-eyebrow"><i class="bi bi-tags"></i> Membership</span>
        <h2 class="section-title">Pick the plan that fits</h2>
        <p class="text-muted-2 mb-0">No lock-in tricks. Every plan gives you the floor, the classes and the coaching.</p>
    </div>

    @if (Model.Plans.Count > 0) {
        <div class="row g-4 justify-content-center">
            @for (var i = 0; i < Model.Plans.Count; i++) {
                var plan = Model.Plans[i];
                var featured = i == 1;
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="pricing-card @(featured ? "is-featured" : "")">
                        @if (featured) {
                            <span class="pill pill--accent mb-3 align-self-start"><i class="bi bi-star-fill"></i>Most popular</span>
                        }
                        <h3 class="h5 mb-2">@plan.Name</h3>
                        <div class="pricing-card__price mb-1">@plan.Price.ToString("N0") <span class="fs-6 text-muted-2">EGP</span></div>
                        <div class="text-muted-2 fs-14 mb-3">for @plan.DurationDays days</div>
                        <p class="text-muted-2 fs-14 flex-grow-1">@plan.Dsescription</p>
                        <a class="btn-app @(featured ? "btn-app--primary" : "btn-app--ghost") btn-app--block" asp-controller="Account" asp-action="Register">
                            Choose @plan.Name
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else {
        <div class="card-app">
            <div class="empty-state">
                <div class="empty-state__icon"><i class="bi bi-tags"></i></div>
                <h3 class="empty-state__title">No plans on sale right now</h3>
                <p class="empty-state__text">Our membership packages are being updated — please check back shortly.</p>
            </div>
        </div>
    }
</section>

@* ---------- Trainers ---------- *@
@if (Model.Trainers.Count > 0) {
    <section class="container py-5">
        <div class="text-center mb-5">
            <span class="section-eyebrow"><i class="bi bi-person-badge"></i> The Team</span>
            <h2 class="section-title">Coaches in your corner</h2>
        </div>

        <div class="row g-4">
            @foreach (var trainer in Model.Trainers) {
                <div class="col-6 col-lg-3">
                    <div class="card-app card-app--hover h-100 text-center">
                        <div class="card-app__body">
                            <partial name="_Avatar" model="@(new AvatarModel { Name = trainer.Name, Photo = trainer.Photo, Folder = "trainers", Size = "lg" })" />
                            <h3 class="h6 mt-3 mb-1">@trainer.Name</h3>
                            <p class="text-muted-2 fs-13 mb-0">@trainer.Specialties</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@* ---------- CTA ---------- *@
<section class="container py-5">
    <div class="card-app" style="background:linear-gradient(135deg,var(--brand-950),var(--brand-800));border:0">
        <div class="card-app__body text-center py-5">
            <h2 class="section-title text-white mb-3">Ready to start training?</h2>
            <p class="mb-4" style="color:#c3c8f5;max-width:520px;margin-inline:auto">
                Create your account, pick a plan, and book your first class today.
            </p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a class="btn-app btn-app--accent btn-app--lg" asp-controller="Account" asp-action="Register">
                    <i class="bi bi-person-plus"></i> Join Power Fitness
                </a>
                <a class="btn-app btn-app--lg" style="background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.3);color:#fff" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </a>
            </div>
        </div>
    </div>
</section>
